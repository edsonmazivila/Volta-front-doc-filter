# =============================================================================
# Volta HR Frontend - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the actual values
# DO NOT commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Datadog Configuration
# -----------------------------------------------------------------------------
# Environment name (e.g., production, staging, development)
DD_ENV=production

# Application version (typically set to git commit SHA or semantic version)
DD_VERSION=1.0.0

# Service name for Datadog APM
DD_SERVICE=volta-hr-frontend

# Trace sampling rate (0.0 to 1.0, where 1.0 = 100% of traces)
DD_TRACE_SAMPLE_RATE=1

# Enable Datadog profiling
DD_PROFILING_ENABLED=true

# Enable trace debugging (set to false in production)
DD_TRACE_DEBUG=false

# Datadog agent host (typically the service name in Kubernetes)
DD_AGENT_HOST=datadog-agent

# Datadog trace agent port
DD_TRACE_AGENT_PORT=8126

# Enable log injection for correlation between logs and traces
DD_LOGS_INJECTION=true

# Enable Datadog APM
DD_APM_ENABLED=true

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Backend API URL (server-side)
API_URL=http://localhost:8080

# Backend API URL (client-side, must be publicly accessible)
NEXT_PUBLIC_API_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Next.js Configuration
# -----------------------------------------------------------------------------
# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Node environment (development, production, test)
NODE_ENV=production

